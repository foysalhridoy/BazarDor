# Secret key used to encrypt and sign session tokens and passwords
# আপনি চাইলে যেকোনো সুরক্ষিত র‍্যান্ডম স্ট্রিং দিতে পারেন
BETTER_AUTH_SECRET="bazardor_super_secret_auth_token_key_2026_exam"

# Base URL of your application
# লোকাল ডেভেলপমেন্টে: http://localhost:3000
# Vercel বা লাইভ সাইটে ডিপ্লয় করার পর: https://your-project-name.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# (ঐচ্ছিক / Optional) যদি রিয়েল সোশ্যাল লগইন বা ডাটাবেজ URL দিতে চান:
